---
import { boda } from '../config/boda';
import Seccion from './Seccion.astro';

const { dressCode } = boda;
---

<Seccion
  id="dress-code"
  eyebrow="Cómo vestirse"
  titulo={dressCode.titulo}
  intro={dressCode.intro}
  fondo="sangre"
  ancho="estrecho"
>
  <p class="revelar display text-acid -mt-4 text-center text-[clamp(1.5rem,5vw,2.75rem)] leading-tight">
    {dressCode.subtitulo}
  </p>

  <div class="revelar border-brass/30 mt-14 border-l-2 py-2 pl-6 sm:pl-8">
    <p class="text-bone-dim text-lg italic sm:text-xl">{dressCode.nota}</p>
  </div>

  <p class="revelar mt-12 text-center">
    <a href="#moodboard" class="btn btn-ghost"> Ver el moodboard </a>
  </p>
</Seccion>
