---
import { boda } from '../config/boda';
import Seccion from './Seccion.astro';
import Ornamento from './Ornamento.astro';

const MAX_ACOMPANANTES = 5;
---

<Seccion
  id="rsvp"
  eyebrow={`Antes del ${boda.fecha.limiteRsvp}`}
  titulo="Confirmar asistencia"
  intro="Llenen un formulario por grupo. Si vienen acompañados, escriban también sus nombres para poder apartarles lugar."
  ancho="normal"
>
  <div class="revelar border-brass/25 bg-ink-2 border p-7 sm:p-11">
    <form id="rsvp-form" novalidate>
      <div class="space-y-7">
        <div>
          <label class="etiqueta" for="rsvp-nombre">Nombre completo *</label>
          <input
            id="rsvp-nombre"
            name="nombre"
            type="text"
            class="campo"
            autocomplete="name"
            placeholder="Nombre y apellidos"
            required
            maxlength="120"
          />
        </div>

        <div>
          <label class="etiqueta" for="rsvp-contacto">Teléfono o correo *</label>
          <input
            id="rsvp-contacto"
            name="contacto"
            type="text"
            class="campo"
            autocomplete="tel"
            inputmode="text"
            placeholder="Para poder avisarles cualquier cambio"
            required
            maxlength="120"
          />
        </div>

        <fieldset>
          <legend class="etiqueta">¿Nos acompañan? *</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="opcion">
              <input type="radio" name="asiste" value="si" class="sr-only" required checked />
              <span class="opcion-caja">Ahí estaremos</span>
            </label>
            <label class="opcion">
              <input type="radio" name="asiste" value="no" class="sr-only" />
              <span class="opcion-caja">No podremos ir</span>
            </label>
          </div>
        </fieldset>

        {/* Todo lo que solo aplica si asisten */}
        <div id="rsvp-si" class="space-y-7">
          <div>
            <label class="etiqueta" for="rsvp-acompanantes">¿Cuántas personas vienen contigo?</label>
            <select id="rsvp-acompanantes" name="acompanantes" class="campo">
              {
                Array.from({ length: MAX_ACOMPANANTES + 1 }, (_, n) => (
                  <option value={n}>
                    {n === 0 ? 'Vengo solo / sola' : n === 1 ? '1 persona' : `${n} personas`}
                  </option>
                ))
              }
            </select>
            <p class="text-ash mt-2 text-sm italic">
              Sin contarte a ti. Si necesitan más lugares, díganlo en el mensaje y lo revisamos.
            </p>
          </div>

          {/* Campos que aparecen según el número elegido */}
          <div id="rsvp-nombres" class="hidden space-y-4">
            <p class="etiqueta">Nombres de quienes vienen contigo</p>
            {
              Array.from({ length: MAX_ACOMPANANTES }, (_, i) => (
                <input
                  type="text"
                  class="campo acompanante hidden"
                  data-indice={i}
                  placeholder={`Acompañante ${i + 1}`}
                  aria-label={`Nombre del acompañante ${i + 1}`}
                  maxlength="120"
                />
              ))
            }
          </div>

          <div>
            <label class="etiqueta" for="rsvp-cancion">Una canción que no puede faltar</label>
            <input
              id="rsvp-cancion"
              name="cancion"
              type="text"
              class="campo"
              placeholder="La que te va a sacar a bailar"
              maxlength="200"
            />
          </div>
        </div>

        <div>
          <label class="etiqueta" for="rsvp-mensaje">Mensaje para nosotros</label>
          <textarea
            id="rsvp-mensaje"
            name="mensaje"
            class="campo resize-y"
            rows="4"
            placeholder="Restricciones alimenticias, alergias, o lo que quieran decirnos"
            maxlength="1500"></textarea>
        </div>
      </div>

      <p
        id="rsvp-error"
        class="text-ember mt-6 min-h-5 font-mono text-[0.6875rem] tracking-[0.14em] uppercase"
        role="alert"
        aria-live="polite"
      >
      </p>

      <button id="rsvp-boton" type="submit" class="btn mt-3 w-full"> Enviar respuesta </button>
    </form>

    {/* Confirmación: sustituye al formulario sin recargar */}
    <div id="rsvp-exito" class="hidden py-8 text-center" role="status" aria-live="polite">
      <Ornamento tipo="corazon" class="text-blood mx-auto mb-7 h-16 w-16" />
      <h3 class="text-bone mb-4 text-3xl sm:text-4xl">Quedó registrado</h3>
      <p id="rsvp-exito-texto" class="text-bone-dim mx-auto max-w-md text-lg"></p>
      <button id="rsvp-otra" type="button" class="btn btn-ghost mt-9">
        Registrar a alguien más
      </button>
    </div>
  </div>
</Seccion>

<script>
  import { enviarRsvp, type DatosRsvp } from '../lib/api';

  const form = document.getElementById('rsvp-form') as HTMLFormElement;
  const exito = document.getElementById('rsvp-exito') as HTMLElement;
  const exitoTexto = document.getElementById('rsvp-exito-texto') as HTMLElement;
  const boton = document.getElementById('rsvp-boton') as HTMLButtonElement;
  const error = document.getElementById('rsvp-error') as HTMLElement;
  const bloqueSi = document.getElementById('rsvp-si') as HTMLElement;
  const bloqueNombres = document.getElementById('rsvp-nombres') as HTMLElement;
  const selectAcompanantes = document.getElementById('rsvp-acompanantes') as HTMLSelectElement;
  const botonOtra = document.getElementById('rsvp-otra') as HTMLButtonElement;

  const inputNombre = document.getElementById('rsvp-nombre') as HTMLInputElement;
  const inputContacto = document.getElementById('rsvp-contacto') as HTMLInputElement;
  const inputCancion = document.getElementById('rsvp-cancion') as HTMLInputElement;
  const inputMensaje = document.getElementById('rsvp-mensaje') as HTMLTextAreaElement;
  const camposAcompanante = Array.from(
    document.querySelectorAll<HTMLInputElement>('.acompanante')
  );

  const MENSAJES: Record<string, string> = {
    password: 'Su sesión expiró. Recarguen la página',
    red: 'Sin conexión. Revisen su internet e inténtenlo otra vez',
    servidor: 'No se pudo guardar. Inténtenlo en un momento',
    sin_configurar: 'El formulario aún no está conectado',
    campos_requeridos: 'Falta el nombre o el contacto',
  };

  function asiste(): boolean {
    return (form.querySelector('input[name="asiste"]:checked') as HTMLInputElement)?.value === 'si';
  }

  /** Muestra tantos campos de acompañante como personas se hayan elegido. */
  function sincronizarAcompanantes() {
    const cantidad = Number(selectAcompanantes.value);
    bloqueNombres.classList.toggle('hidden', cantidad === 0);

    camposAcompanante.forEach((campo, i) => {
      const visible = i < cantidad;
      campo.classList.toggle('hidden', !visible);
      if (!visible) campo.value = '';
    });
  }

  /** Quien no asiste no necesita ver nada sobre acompañantes ni canciones. */
  function sincronizarAsistencia() {
    const viene = asiste();
    bloqueSi.classList.toggle('hidden', !viene);
    if (viene) sincronizarAcompanantes();
  }

  form.querySelectorAll('input[name="asiste"]').forEach((radio) => {
    radio.addEventListener('change', sincronizarAsistencia);
  });

  selectAcompanantes.addEventListener('change', sincronizarAcompanantes);

  function pintarError(codigo: string | null) {
    error.textContent = codigo ? (MENSAJES[codigo] ?? MENSAJES.servidor) : '';
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    pintarError(null);

    const nombre = inputNombre.value.trim();
    const contacto = inputContacto.value.trim();

    // Validación en el cliente para no gastar un viaje al servidor.
    for (const [campo, valor] of [
      [inputNombre, nombre],
      [inputContacto, contacto],
    ] as const) {
      if (!valor) {
        campo.setAttribute('aria-invalid', 'true');
        campo.focus();
        pintarError('campos_requeridos');
        return;
      }
      campo.setAttribute('aria-invalid', 'false');
    }

    const viene = asiste();
    const cantidad = viene ? Number(selectAcompanantes.value) : 0;

    const datos: DatosRsvp = {
      nombre,
      contacto,
      asiste: viene ? 'si' : 'no',
      acompanantes: cantidad,
      nombresAcompanantes: camposAcompanante.slice(0, cantidad).map((c) => c.value.trim()),
      cancion: viene ? inputCancion.value.trim() : '',
      mensaje: inputMensaje.value.trim(),
    };

    boton.disabled = true;
    boton.textContent = 'Enviando…';

    const resultado = await enviarRsvp(datos);

    boton.disabled = false;
    boton.textContent = 'Enviar respuesta';

    if (!resultado.ok) {
      pintarError(resultado.error);
      return;
    }

    exitoTexto.textContent = viene
      ? cantidad > 0
        ? `Los esperamos a ustedes ${cantidad + 1}. Nos vemos el 31 de octubre.`
        : 'Te esperamos el 31 de octubre.'
      : 'Gracias por avisarnos. Los vamos a extrañar esa noche.';

    form.classList.add('hidden');
    exito.classList.remove('hidden');
    exito.scrollIntoView({ block: 'center', behavior: 'smooth' });
  });

  // Permite confirmar a varias personas seguidas desde el mismo dispositivo.
  botonOtra.addEventListener('click', () => {
    form.reset();
    sincronizarAsistencia();
    pintarError(null);
    exito.classList.add('hidden');
    form.classList.remove('hidden');
    inputNombre.focus();
  });

  sincronizarAsistencia();
</script>

<style>
  /* Radios vestidos como botones: el control nativo va en .sr-only. */
  .opcion {
    cursor: pointer;
  }

  .opcion-caja {
    display: block;
    padding: 0.9rem 1rem;
    text-align: center;
    background-color: var(--color-ink);
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-bone-dim);
    transition:
      background-color 0.3s var(--ease-vela),
      border-color 0.3s var(--ease-vela),
      color 0.3s var(--ease-vela);
  }

  .opcion:hover .opcion-caja {
    border-color: color-mix(in srgb, var(--color-brass) 50%, transparent);
    color: var(--color-bone);
  }

  .opcion input:checked + .opcion-caja {
    background-color: var(--color-oxblood);
    border-color: var(--color-brass);
    color: var(--color-bone);
  }

  /* El foco tiene que verse aunque el input real esté oculto. */
  .opcion input:focus-visible + .opcion-caja {
    outline: 2px solid var(--color-brass);
    outline-offset: 3px;
  }
</style>
