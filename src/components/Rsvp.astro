---
import { boda } from '../config/boda';
import Seccion from './Seccion.astro';
import Ornamento from './Ornamento.astro';

/**
 * La confirmación tiene cuatro pantallas dentro de la misma caja: buscar,
 * confirmar, listo, y el formulario abierto de emergencia. Solo una está
 * visible a la vez; las cambia `mostrarPaso()` en el script de abajo.
 *
 * El emparejado difuso de nombres corre en Apps Script, no aquí: así la lista
 * completa de invitados nunca llega al navegador.
 */
---

<Seccion
  id="rsvp"
  eyebrow={`Antes del ${boda.fecha.limiteRsvp}`}
  titulo="Confirmar asistencia"
  intro={boda.rsvp.intro}
  ancho="normal"
>
  <div class="revelar border-brass/25 bg-ink-2 border p-7 sm:p-11">
    {/* ------------------------------------------------ 1. Buscador */}
    <div id="paso-buscar">
      <form id="buscar-form" novalidate>
        <label class="etiqueta" for="buscar-input">Tu nombre</label>

        <div class="flex flex-col gap-3 sm:flex-row">
          <input
            id="buscar-input"
            type="text"
            class="campo sm:flex-1"
            autocomplete="name"
            autocapitalize="words"
            autocorrect="off"
            spellcheck="false"
            placeholder="Nombre y apellido"
            maxlength="80"
          />
          <button id="buscar-boton" type="submit" class="btn sm:w-40 sm:shrink-0">
            Buscarme
          </button>
        </div>
      </form>

      <p
        id="buscar-estado"
        class="text-bone-dim mt-6 min-h-5 font-mono text-[0.6875rem] tracking-[0.14em] uppercase"
        role="status"
        aria-live="polite"
      >
      </p>

      {/* Los candidatos los pinta el script. */}
      <ul id="buscar-resultados" class="hidden space-y-2.5"></ul>

      <p id="buscar-mas" class="text-ash mt-4 hidden text-sm italic"></p>

      <div class="border-brass/15 mt-9 border-t pt-7 text-center">
        <button id="abrir-plan-b" type="button" class="enlace-sobrio">
          {boda.rsvp.enlacePlanB}
        </button>
      </div>
    </div>

    {/* ------------------------------------------------ 2. Confirmación */}
    <div id="paso-confirmar" class="hidden">
      <button id="confirmar-volver" type="button" class="enlace-sobrio mb-8">
        ← Buscar otro nombre
      </button>

      <p class="etiqueta">Confirmando a</p>
      <h3 id="confirmar-nombre" class="text-bone mb-2 text-3xl sm:text-4xl"></h3>

      <form id="confirmar-form" class="mt-8 space-y-7" novalidate>
        <fieldset>
          <legend class="etiqueta">¿Nos acompañas? *</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="opcion">
              <input type="radio" name="confirmar-asiste" value="si" class="sr-only" checked />
              <span class="opcion-caja">Ahí estaré</span>
            </label>
            <label class="opcion">
              <input type="radio" name="confirmar-asiste" value="no" class="sr-only" />
              <span class="opcion-caja">No podré ir</span>
            </label>
          </div>
        </fieldset>

        <div>
          <label class="etiqueta" for="confirmar-mail">Correo *</label>
          <input
            id="confirmar-mail"
            type="email"
            class="campo"
            autocomplete="email"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            placeholder="tu@correo.com"
            maxlength="120"
          />
        </div>

        <div>
          <label class="etiqueta" for="confirmar-telefono">Teléfono *</label>
          <input
            id="confirmar-telefono"
            type="tel"
            class="campo"
            autocomplete="tel"
            inputmode="tel"
            placeholder="Con WhatsApp, para avisarte cualquier cambio"
            maxlength="60"
          />
        </div>

        <p
          id="confirmar-error"
          class="text-ember min-h-5 font-mono text-[0.6875rem] tracking-[0.14em] uppercase"
          role="alert"
          aria-live="polite"
        >
        </p>

        <button id="confirmar-boton" type="submit" class="btn w-full">
          Enviar mi respuesta
        </button>
      </form>
    </div>

    {/* ------------------------------------------------ 3. Listo */}
    <div id="paso-exito" class="hidden py-8 text-center" role="status" aria-live="polite">
      <Ornamento tipo="corazon" class="text-acid mx-auto mb-7 h-16 w-16" />
      <h3 class="text-bone mb-4 text-3xl sm:text-4xl">Quedó registrado</h3>
      <p id="exito-texto" class="text-bone-dim mx-auto max-w-md text-lg"></p>
      <button id="exito-otra" type="button" class="btn btn-ghost mt-9">
        Confirmar a alguien más
      </button>
    </div>

    {/* ------------------------------------------------ 4. Plan B: formulario abierto */}
    <div id="paso-abierto" class="hidden">
      <button id="cerrar-plan-b" type="button" class="enlace-sobrio mb-8">
        ← Volver a buscar mi nombre
      </button>

      <p class="text-bone-dim mb-8">{boda.rsvp.introPlanB}</p>

      <form id="rsvp-form" novalidate>
        <div class="space-y-7">
          <div>
            <label class="etiqueta" for="rsvp-nombre">Nombre completo *</label>
            <input
              id="rsvp-nombre"
              name="nombre"
              type="text"
              class="campo"
              autocomplete="name"
              placeholder="Nombre y apellidos"
              required
              maxlength="120"
            />
          </div>

          <fieldset>
            <legend class="etiqueta">¿Nos acompañas? *</legend>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="opcion">
                <input type="radio" name="asiste" value="si" class="sr-only" required checked />
                <span class="opcion-caja">Ahí estaré</span>
              </label>
              <label class="opcion">
                <input type="radio" name="asiste" value="no" class="sr-only" />
                <span class="opcion-caja">No podré ir</span>
              </label>
            </div>
          </fieldset>

          <div>
            <label class="etiqueta" for="rsvp-mail">Correo *</label>
            <input
              id="rsvp-mail"
              name="mail"
              type="email"
              class="campo"
              autocomplete="email"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              placeholder="tu@correo.com"
              maxlength="120"
            />
          </div>

          <div>
            <label class="etiqueta" for="rsvp-telefono">Teléfono *</label>
            <input
              id="rsvp-telefono"
              name="telefono"
              type="tel"
              class="campo"
              autocomplete="tel"
              inputmode="tel"
              placeholder="Con WhatsApp, para avisarte cualquier cambio"
              maxlength="60"
            />
          </div>
        </div>

        <p
          id="rsvp-error"
          class="text-ember mt-6 min-h-5 font-mono text-[0.6875rem] tracking-[0.14em] uppercase"
          role="alert"
          aria-live="polite"
        >
        </p>

        <button id="rsvp-boton" type="submit" class="btn mt-3 w-full"> Enviar respuesta </button>
      </form>
    </div>
  </div>
</Seccion>

<script>
  import {
    buscarInvitado,
    confirmarInvitado,
    enviarRsvp,
    type DatosRsvp,
    type InvitadoEncontrado,
  } from '../lib/api';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const MENSAJES: Record<string, string> = {
    password: 'Su sesión expiró. Recarguen la página',
    red: 'Sin conexión. Revisen su internet e inténtenlo otra vez',
    servidor: 'Algo falló. Inténtenlo en un momento',
    sin_configurar: 'El formulario aún no está conectado',
    campos_requeridos: 'Faltan el correo o el teléfono',
    falta_nombre: 'Falta tu nombre',
    consulta_corta: 'Escriban al menos tres letras',
    fila_cambio: 'La lista cambió. Búsquense otra vez, por favor',
    mail_invalido: 'Ese correo no se ve bien. Revísenlo',
    telefono_invalido: 'Ese teléfono no se ve bien. Revísenlo',
  };

  // -------------------------------------------------------------------------
  // Navegación entre pantallas
  // -------------------------------------------------------------------------

  const PASOS = ['buscar', 'confirmar', 'exito', 'abierto'] as const;
  type Paso = (typeof PASOS)[number];

  function mostrarPaso(paso: Paso) {
    for (const nombre of PASOS) {
      $(`paso-${nombre}`).classList.toggle('hidden', nombre !== paso);
    }
  }

  // -------------------------------------------------------------------------
  // 1. Buscador
  // -------------------------------------------------------------------------

  const entradaBusqueda = $<HTMLInputElement>('buscar-input');
  const formBusqueda = $<HTMLFormElement>('buscar-form');
  const botonBusqueda = $<HTMLButtonElement>('buscar-boton');
  const estadoBusqueda = $('buscar-estado');
  const listaResultados = $<HTMLUListElement>('buscar-resultados');
  const avisoMas = $('buscar-mas');

  const MINIMO = 3;

  /**
   * Cada búsqueda lleva número. Si alguien le da a «Buscarme» dos veces
   * seguidas, la respuesta de la primera puede llegar después de la segunda:
   * si el número ya no es el último, se tira.
   */
  let secuencia = 0;

  function limpiarResultados() {
    listaResultados.replaceChildren();
    listaResultados.classList.add('hidden');
    avisoMas.classList.add('hidden');
  }

  function pintarEstado(texto: string) {
    estadoBusqueda.textContent = texto;
  }

  function tarjetaResultado(invitado: InvitadoEncontrado): HTMLLIElement {
    const li = document.createElement('li');

    const boton = document.createElement('button');
    boton.type = 'button';
    boton.className = 'resultado';

    const nombre = document.createElement('span');
    // textContent y no innerHTML: el nombre viene de la hoja de cálculo.
    nombre.textContent = invitado.nombre;
    nombre.className = 'resultado-nombre';
    boton.appendChild(nombre);

    boton.addEventListener('click', () => abrirConfirmacion(invitado));
    li.appendChild(boton);

    return li;
  }

  async function lanzarBusqueda() {
    const consulta = entradaBusqueda.value.trim();

    if (consulta.length < MINIMO) {
      limpiarResultados();
      pintarEstado(MENSAJES.consulta_corta);
      return;
    }

    const mia = ++secuencia;
    pintarEstado('Buscando…');
    botonBusqueda.disabled = true;

    const resultado = await buscarInvitado(consulta);

    // Llegó tarde: ya hay una búsqueda más nueva en curso.
    if (mia !== secuencia) return;

    botonBusqueda.disabled = false;

    if (!resultado.ok) {
      limpiarResultados();
      pintarEstado(MENSAJES[resultado.error] ?? MENSAJES.servidor);
      return;
    }

    const { resultados, total } = resultado;

    if (!resultados.length) {
      limpiarResultados();
      pintarEstado('No encontramos ese nombre');
      avisoMas.textContent =
        'Prueben con el apellido, o con menos palabras. Si aun así no aparece, usen el enlace de abajo y los agregamos a mano.';
      avisoMas.classList.remove('hidden');
      return;
    }

    pintarEstado(resultados.length === 1 ? '1 coincidencia' : `${resultados.length} coincidencias`);

    listaResultados.replaceChildren(...resultados.map(tarjetaResultado));
    listaResultados.classList.remove('hidden');

    // Cuando hay más de los que caben, la salida es afinar la búsqueda.
    if (total > resultados.length) {
      avisoMas.textContent = `Hay ${total} parecidos. Agreguen su apellido para acortar la lista.`;
      avisoMas.classList.remove('hidden');
    } else {
      avisoMas.classList.add('hidden');
    }
  }

  /*
   * La búsqueda sale solo al dar «Buscarme» (o Enter), no mientras escriben:
   * cada consulta es un viaje a Apps Script de un par de segundos, y buscar a
   * medio nombre devuelve candidatos que se van cambiando debajo del cursor.
   */
  formBusqueda.addEventListener('submit', (e) => {
    e.preventDefault();
    void lanzarBusqueda();
  });

  // Al reescribir, los resultados anteriores ya no corresponden.
  entradaBusqueda.addEventListener('input', () => {
    if (!listaResultados.classList.contains('hidden') || estadoBusqueda.textContent) {
      secuencia++; // invalida cualquier respuesta en vuelo
      limpiarResultados();
      pintarEstado('');
    }
  });

  // -------------------------------------------------------------------------
  // 2. Confirmación
  // -------------------------------------------------------------------------

  const formConfirmar = $<HTMLFormElement>('confirmar-form');
  const nombreConfirmar = $('confirmar-nombre');
  const mailConfirmar = $<HTMLInputElement>('confirmar-mail');
  const telefonoConfirmar = $<HTMLInputElement>('confirmar-telefono');
  const errorConfirmar = $('confirmar-error');
  const botonConfirmar = $<HTMLButtonElement>('confirmar-boton');

  let elegido: InvitadoEncontrado | null = null;

  function radioAsiste(): HTMLInputElement | null {
    return formConfirmar.querySelector('input[name="confirmar-asiste"]:checked');
  }

  function abrirConfirmacion(invitado: InvitadoEncontrado) {
    elegido = invitado;

    nombreConfirmar.textContent = invitado.nombre;
    errorConfirmar.textContent = '';

    for (const campo of [mailConfirmar, telefonoConfirmar]) {
      campo.value = '';
      campo.setAttribute('aria-invalid', 'false');
    }

    // Siempre se arranca en «Ahí estaré»: no se muestra qué respondió antes.
    const radio = formConfirmar.querySelector<HTMLInputElement>(
      'input[name="confirmar-asiste"][value="si"]'
    );
    if (radio) radio.checked = true;

    mostrarPaso('confirmar');
    mailConfirmar.focus();
  }

  formConfirmar.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!elegido) return;

    errorConfirmar.textContent = '';

    const mail = mailConfirmar.value.trim();
    const telefono = telefonoConfirmar.value.trim();

    // Se valida aquí lo mismo que valida el servidor, para no gastar un viaje.
    const problemas: [HTMLInputElement, boolean, string][] = [
      [mailConfirmar, !mail, 'campos_requeridos'],
      [mailConfirmar, mail.indexOf('@') < 1 || !mail.includes('.'), 'mail_invalido'],
      [telefonoConfirmar, !telefono, 'campos_requeridos'],
      [telefonoConfirmar, telefono.replace(/\D/g, '').length < 8, 'telefono_invalido'],
    ];

    mailConfirmar.setAttribute('aria-invalid', 'false');
    telefonoConfirmar.setAttribute('aria-invalid', 'false');

    for (const [campo, falla, codigo] of problemas) {
      if (!falla) continue;
      campo.setAttribute('aria-invalid', 'true');
      campo.focus();
      errorConfirmar.textContent = MENSAJES[codigo];
      return;
    }

    const viene = radioAsiste()?.value === 'si';

    botonConfirmar.disabled = true;
    botonConfirmar.textContent = 'Enviando…';

    const resultado = await confirmarInvitado({
      fila: elegido.fila,
      nombre: elegido.nombre,
      asiste: viene ? 'si' : 'no',
      mail,
      telefono,
    });

    botonConfirmar.disabled = false;
    botonConfirmar.textContent = 'Enviar mi respuesta';

    if (!resultado.ok) {
      errorConfirmar.textContent = MENSAJES[resultado.error] ?? MENSAJES.servidor;

      // Si movieron filas en la hoja, el número que traíamos ya no sirve:
      // hay que volver a buscar para conseguir uno bueno.
      if (resultado.error === 'fila_cambio') {
        pintarEstado(MENSAJES.fila_cambio);
        limpiarResultados();
        mostrarPaso('buscar');
        entradaBusqueda.focus();
      }
      return;
    }

    const nombreCorto = elegido.nombre.split(/\s+/)[0];
    $('exito-texto').textContent = viene
      ? `Te esperamos, ${nombreCorto}. Nos vemos el 31 de octubre.`
      : 'Gracias por avisarnos. Te vamos a extrañar esa noche.';

    mostrarPaso('exito');
    $('paso-exito').scrollIntoView({ block: 'center', behavior: 'smooth' });
  });

  $('confirmar-volver').addEventListener('click', () => {
    mostrarPaso('buscar');
    entradaBusqueda.focus();
    entradaBusqueda.select();
  });

  // -------------------------------------------------------------------------
  // 3. Volver a empezar
  // -------------------------------------------------------------------------

  $('exito-otra').addEventListener('click', () => {
    elegido = null;
    entradaBusqueda.value = '';
    limpiarResultados();
    pintarEstado('');
    mostrarPaso('buscar');
    entradaBusqueda.focus();
  });

  // -------------------------------------------------------------------------
  // 4. Plan B: el formulario abierto de siempre
  // -------------------------------------------------------------------------

  $('abrir-plan-b').addEventListener('click', () => {
    mostrarPaso('abierto');
    $('rsvp-nombre').focus();
  });

  $('cerrar-plan-b').addEventListener('click', () => {
    mostrarPaso('buscar');
    entradaBusqueda.focus();
  });

  const form = $<HTMLFormElement>('rsvp-form');
  const boton = $<HTMLButtonElement>('rsvp-boton');
  const error = $('rsvp-error');

  const inputNombre = $<HTMLInputElement>('rsvp-nombre');
  const inputMail = $<HTMLInputElement>('rsvp-mail');
  const inputTelefono = $<HTMLInputElement>('rsvp-telefono');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.textContent = '';

    const nombre = inputNombre.value.trim();
    const mail = inputMail.value.trim();
    const telefono = inputTelefono.value.trim();

    // Las mismas reglas que valida el servidor, para no gastar un viaje.
    const problemas: [HTMLInputElement, boolean, string][] = [
      [inputNombre, !nombre, 'falta_nombre'],
      [inputMail, !mail, 'campos_requeridos'],
      [inputMail, mail.indexOf('@') < 1 || !mail.includes('.'), 'mail_invalido'],
      [inputTelefono, !telefono, 'campos_requeridos'],
      [inputTelefono, telefono.replace(/\D/g, '').length < 8, 'telefono_invalido'],
    ];

    for (const campo of [inputNombre, inputMail, inputTelefono]) {
      campo.setAttribute('aria-invalid', 'false');
    }

    for (const [campo, falla, codigo] of problemas) {
      if (!falla) continue;
      campo.setAttribute('aria-invalid', 'true');
      campo.focus();
      error.textContent = MENSAJES[codigo];
      return;
    }

    const viene =
      (form.querySelector('input[name="asiste"]:checked') as HTMLInputElement)?.value === 'si';

    const datos: DatosRsvp = { nombre, asiste: viene ? 'si' : 'no', mail, telefono };

    boton.disabled = true;
    boton.textContent = 'Enviando…';

    const resultado = await enviarRsvp(datos);

    boton.disabled = false;
    boton.textContent = 'Enviar respuesta';

    if (!resultado.ok) {
      error.textContent = MENSAJES[resultado.error] ?? MENSAJES.servidor;
      return;
    }

    $('exito-texto').textContent = viene
      ? 'Te esperamos el 31 de octubre.'
      : 'Gracias por avisarnos. Te vamos a extrañar esa noche.';

    form.reset();
    mostrarPaso('exito');
    $('paso-exito').scrollIntoView({ block: 'center', behavior: 'smooth' });
  });
</script>

<style>
  /* Radios vestidos como botones: el control nativo va en .sr-only. */
  .opcion {
    cursor: pointer;
  }

  .opcion-caja {
    display: block;
    padding: 0.9rem 1rem;
    text-align: center;
    background-color: var(--color-ink);
    border: 1px solid color-mix(in srgb, var(--color-brass) 25%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-bone-dim);
    transition:
      background-color 0.3s var(--ease-vela),
      border-color 0.3s var(--ease-vela),
      color 0.3s var(--ease-vela);
  }

  .opcion:hover .opcion-caja {
    border-color: color-mix(in srgb, var(--color-brass) 50%, transparent);
    color: var(--color-bone);
  }

  .opcion input:checked + .opcion-caja {
    background-color: var(--color-oxblood);
    border-color: var(--color-brass);
    color: var(--color-bone);
  }

  /* El foco tiene que verse aunque el input real esté oculto. */
  .opcion input:focus-visible + .opcion-caja {
    outline: 2px solid var(--color-brass);
    outline-offset: 3px;
  }

  /*
   * Los candidatos los crea el script en tiempo de ejecución, así que nunca
   * reciben el atributo de scope que Astro le pone al marcado del template y
   * un selector normal no los alcanzaría. Se anclan a #buscar-resultados —que
   * sí está en el template y sí lleva el scope— y de ahí para dentro se marcan
   * como globales.
   */
  #buscar-resultados :global(.resultado) {
    display: flex;
    width: 100%;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.95rem 1.15rem;
    cursor: pointer;
    text-align: left;
    background-color: var(--color-ink);
    border: 1px solid color-mix(in srgb, var(--color-brass) 22%, transparent);
    transition:
      background-color 0.3s var(--ease-vela),
      border-color 0.3s var(--ease-vela);
  }

  #buscar-resultados :global(.resultado:hover),
  #buscar-resultados :global(.resultado:focus-visible) {
    background-color: var(--color-oxblood);
    border-color: var(--color-brass);
  }

  #buscar-resultados :global(.resultado-nombre) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-bone);
  }


  /* Enlaces de navegación entre pantallas: texto, no botón. */
  .enlace-sobrio {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ash);
    cursor: pointer;
    text-decoration-line: underline;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, var(--color-brass) 40%, transparent);
    transition: color 0.3s var(--ease-vela);
  }

  .enlace-sobrio:hover {
    color: var(--color-bone);
  }
</style>
