---
import { boda } from '../config/boda';
import Seccion from './Seccion.astro';
---

<Seccion id="la-boda" eyebrow="El plan" titulo="La boda" ancho="normal">
  {/* Cuándo y dónde, en una sola columna centrada. */}
  <div class="revelar space-y-10 text-center">
    <div>
      <p class="eyebrow mb-3">Cuándo</p>
      <p class="display text-bone text-2xl leading-tight sm:text-3xl">{boda.fecha.displayLargo}</p>
      <p class="text-bone-dim mt-3 font-mono text-xs tracking-[0.22em] uppercase">
        {boda.fecha.horaInicio} — {boda.fecha.horaFin}
      </p>
    </div>

    <div class="filete" aria-hidden="true"></div>

    <div>
      <p class="eyebrow mb-3">Dónde</p>
      <p class="display text-bone text-2xl leading-tight sm:text-3xl">{boda.venue.nombre}</p>
      <address class="text-bone-dim mt-3 text-lg not-italic">
        {boda.venue.calle}<br />
        {boda.venue.colonia} · {boda.venue.ciudad}
      </address>

      <a
        href={boda.venue.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-ghost mt-7"
      >
        Abrir en Google Maps
      </a>
    </div>
  </div>

</Seccion>
