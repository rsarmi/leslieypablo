---
/**
 * Marcas ornamentales del moodboard, dibujadas como SVG inline para que
 * hereden `currentColor` y no cuesten un request.
 */
interface Props {
  tipo: 'corazon' | 'murcielago' | 'rombo' | 'daga';
  class?: string;
}

const { tipo, class: clase = '' } = Astro.props;
---

{
  /* Corazón sagrado atravesado por tres dagas: la marca de la boda. */
  tipo === 'corazon' && (
    <svg
      class={clase}
      viewBox="0 0 100 100"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M50 88C50 88 18 68 18 44.5C18 32 27 24 37 24C43.5 24 48 27.5 50 31C52 27.5 56.5 24 63 24C73 24 82 32 82 44.5C82 68 50 88 50 88Z"
        fill="currentColor"
        fill-opacity="0.14"
      />
      {/* daga central */}
      <path d="M50 8V96" />
      <path d="M40 22H60" />
      <path d="M46 8H54" />
      {/* daga izquierda */}
      <path d="M27 16L67 92" />
      <path d="M21 31L34 24" />
      {/* daga derecha */}
      <path d="M73 16L33 92" />
      <path d="M79 31L66 24" />
    </svg>
  )
}

{
  tipo === 'murcielago' && (
    <svg class={clase} viewBox="0 0 120 56" fill="currentColor" aria-hidden="true">
      <path d="M60 12c2.2 0 4 2.4 4 5.6 0 1-.2 2-.5 2.8 2.6 1.6 4.4 4.4 5 7.8 1.6-3.4 4-5.6 7-5.6.6 0 1.2.1 1.8.3-1-3.4-.6-6.6 1-8.9-3.4 4.4-9.4 3-13.6-1.4-.6 1.3-1.5 2.4-2.6 3.1-.4-2.2-1.4-3.7-2.1-3.7Z" />
      <path d="M56.6 20.4c-.3-.8-.5-1.8-.5-2.8 0-3.2 1.8-5.6 4-5.6-.7 0-1.7 1.5-2.1 3.7-1.1-.7-2-1.8-2.6-3.1C51.2 17 45.2 18.4 41.8 14c1.6 2.3 2 5.5 1 8.9.6-.2 1.2-.3 1.8-.3 3 0 5.4 2.2 7 5.6.6-3.4 2.4-6.2 5-7.8Z" />
      <path d="M60 22c-4.4 0-8 4-8.6 9.4-3-5-8-8.8-14-10.6-6.8-2-13.6-.6-18.4 3 3.4 0 6 1.4 7.4 3.8-3.6.4-6.6 2.6-8 5.8 2.6-1.2 5.4-1.2 7.6 0-2.8 1.8-4.6 4.8-4.6 8.2 2-2.6 5-4 8.2-3.8-1.4 2.4-1.6 5.2-.6 7.8 1.4-3 4-5.2 7.2-6 4.8-1.2 9.8.6 13 4.2 2-3.4 5.6-5.6 9.8-5.6s7.8 2.2 9.8 5.6c3.2-3.6 8.2-5.4 13-4.2 3.2.8 5.8 3 7.2 6 1-2.6.8-5.4-.6-7.8 3.2-.2 6.2 1.2 8.2 3.8 0-3.4-1.8-6.4-4.6-8.2 2.2-1.2 5-1.2 7.6 0-1.4-3.2-4.4-5.4-8-5.8 1.4-2.4 4-3.8 7.4-3.8-4.8-3.6-11.6-5-18.4-3-6 1.8-11 5.6-14 10.6C68 26 64.4 22 60 22Z" />
    </svg>
  )
}

{
  tipo === 'rombo' && (
    <svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <path d="M12 2L20 12L12 22L4 12Z" />
      <path d="M12 7L16.5 12L12 17L7.5 12Z" fill="currentColor" fill-opacity="0.5" stroke="none" />
    </svg>
  )
}

{
  tipo === 'daga' && (
    <svg
      class={clase}
      viewBox="0 0 16 64"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M8 2V62" />
      <path d="M2 18H14" />
      <path d="M5 2H11" />
      <path d="M6 22H10" />
    </svg>
  )
}
