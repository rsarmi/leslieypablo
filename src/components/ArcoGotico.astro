---
/**
 * Marco de arco ojival. Envuelve cualquier contenido (imagen, placeholder,
 * bloque de texto) y le da la silueta de la portada de catedral del moodboard.
 *
 * El borde dorado va en un elemento aparte detrás del contenido, porque
 * `clip-path` recorta los bordes CSS del propio elemento.
 */
interface Props {
  /** `ojival` es el arco apuntado; `suave` es el arco de medio punto. */
  variante?: 'ojival' | 'suave';
  /** Proporción del marco. */
  ratio?: string;
  /** Dibuja el filo de latón alrededor. */
  filo?: boolean;
  class?: string;
}

const { variante = 'ojival', ratio = '3 / 4', filo = true, class: clase = '' } = Astro.props;
const formaClase = variante === 'ojival' ? 'arco' : 'arco-suave';
---

<div class={`relative ${clase}`} style={`aspect-ratio:${ratio}`}>
  {
    filo && (
      <div
        class={`bg-brass/45 absolute -inset-px ${formaClase}`}
        aria-hidden="true"
      />
    )
  }

  <div class={`bg-ink-2 absolute inset-0 overflow-hidden ${formaClase}`}>
    <slot />
  </div>
</div>
