---
import { boda } from '../config/boda';
import { ruta } from '../lib/rutas';
import Seccion from './Seccion.astro';
import Ornamento from './Ornamento.astro';

const { items } = boda.moodboard;

/**
 * Mosaico irregular con `columns` de CSS: masonry real sin JavaScript ni
 * librería. Las alturas dispares las da la proporción natural de cada
 * imagen, que no se recorta.
 */
---

{/* Sin intro ni pie: las imágenes hablan solas. */}
<Seccion id="moodboard" eyebrow="La estética" titulo="Moodboard" ancho="ancho">
  <div class="columns-2 gap-3 sm:columns-3 sm:gap-4 lg:columns-4">
    {
      items.map((item, i) => {
        const vacio = !item.src;

        /*
         * Las imágenes NO se recortan: van sin aspect-ratio impuesto y con
         * altura automática, así que cada una conserva su proporción real y
         * el mosaico se acomoda alrededor. El `ratio` del config solo sirve
         * para darle altura al hueco mientras no hay imagen.
         */
        if (vacio) {
          return (
            <figure class="revelar mb-3 break-inside-avoid sm:mb-4">
              <div
                class="bg-ink-2 border-brass/20 relative flex items-center justify-center gap-2.5 border"
                style={`aspect-ratio:${item.ratio}`}
              >
                <div
                  class="absolute inset-0"
                  style="background:linear-gradient(150deg, rgba(87,19,16,0.4), rgba(21,5,3,0.5))"
                />
                <Ornamento tipo="rombo" class="text-brass/50 relative h-4 w-4" />
                <span class="text-ash relative font-mono text-[0.5625rem] tracking-[0.2em] uppercase">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
            </figure>
          );
        }

        return (
          <figure class="revelar mb-3 break-inside-avoid sm:mb-4">
            <button
              type="button"
              class="group border-brass/20 block w-full cursor-zoom-in border"
              data-lightbox={ruta(item.src)}
              data-alt={item.alt}
              aria-label={`Ampliar: ${item.alt}`}
            >
              <img
                src={ruta(item.src)}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                class="filmico block h-auto w-full transition-opacity duration-500 group-hover:opacity-85"
              />
            </button>
          </figure>
        );
      })
    }
  </div>

</Seccion>

{/* Lightbox: uno solo para todo el mosaico, oculto hasta que se necesita. */}
<div
  id="lightbox"
  class="bg-ink/97 fixed inset-0 z-[9997] hidden items-center justify-center p-4 backdrop-blur-sm sm:p-10"
  role="dialog"
  aria-modal="true"
  aria-label="Imagen ampliada"
>
  <button
    id="lightbox-cerrar"
    type="button"
    class="text-bone-dim hover:text-bone absolute top-4 right-5 z-10 font-mono text-[0.625rem] tracking-[0.22em] uppercase transition-colors sm:top-7 sm:right-8"
  >
    Cerrar ✕
  </button>

  <button
    id="lightbox-prev"
    type="button"
    class="text-brass/60 hover:text-brass absolute top-1/2 left-2 z-10 -translate-y-1/2 p-4 text-3xl transition-colors sm:left-5"
    aria-label="Imagen anterior"
  >
    ‹
  </button>

  <button
    id="lightbox-next"
    type="button"
    class="text-brass/60 hover:text-brass absolute top-1/2 right-2 z-10 -translate-y-1/2 p-4 text-3xl transition-colors sm:right-5"
    aria-label="Imagen siguiente"
  >
    ›
  </button>

  <img
    id="lightbox-img"
    src=""
    alt=""
    class="border-brass/30 max-h-[86vh] max-w-full border object-contain"
  />
</div>

<script>
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const imagen = document.getElementById('lightbox-img') as HTMLImageElement;
  const botonCerrar = document.getElementById('lightbox-cerrar') as HTMLButtonElement;
  const botonPrev = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const botonNext = document.getElementById('lightbox-next') as HTMLButtonElement;

  const disparadores = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]')
  );

  let indice = 0;
  let ultimoFoco: HTMLElement | null = null;

  // Con menos de dos imágenes las flechas sobran.
  if (disparadores.length < 2) {
    botonPrev.hidden = true;
    botonNext.hidden = true;
  }

  function pintar(i: number) {
    // Módulo con corrección: en JS (-1 % n) da -1, no n-1.
    indice = ((i % disparadores.length) + disparadores.length) % disparadores.length;
    const origen = disparadores[indice];
    imagen.src = origen.dataset.lightbox ?? '';
    imagen.alt = origen.dataset.alt ?? '';
  }

  function abrir(i: number) {
    ultimoFoco = document.activeElement as HTMLElement;
    pintar(i);
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
    botonCerrar.focus();
  }

  function cerrar() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
    imagen.src = '';
    ultimoFoco?.focus();
  }

  disparadores.forEach((boton, i) => boton.addEventListener('click', () => abrir(i)));

  botonCerrar.addEventListener('click', cerrar);
  botonPrev.addEventListener('click', () => pintar(indice - 1));
  botonNext.addEventListener('click', () => pintar(indice + 1));

  // Clic en el fondo (no en la imagen ni en los controles) cierra.
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) cerrar();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;

    if (e.key === 'Escape') cerrar();
    else if (e.key === 'ArrowLeft') pintar(indice - 1);
    else if (e.key === 'ArrowRight') pintar(indice + 1);
  });
</script>
