---
import { boda } from '../config/boda';
import { ruta } from '../lib/rutas';
---

<section
  id="inicio"
  class="vineta relative flex min-h-[100svh] flex-col items-center justify-center gap-12 py-16 sm:gap-16"
>
  {/*
    Banda de tres fotos a todo lo ancho, sin recortes raros: rectángulos
    horizontales del mismo alto separados por un filo de latón. Las fotos ya
    vienen en la paleta (luz roja, grano de película), así que no llevan filtro.
  */}
  <div class="bg-brass/30 revelar relative grid w-full grid-cols-3 gap-px">
    {
      boda.portada.map((foto, i) => (
        <figure class="bg-ink-2 relative overflow-hidden" style="aspect-ratio:3 / 2">
          <img
            src={ruta(foto.src)}
            alt={foto.alt}
            width="1300"
            height="867"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
            class="h-full w-full object-cover"
          />
        </figure>
      ))
    }
  </div>

  <div class="relative w-full max-w-3xl px-5 text-center">
    <h1 class="revelar text-bone text-[clamp(2.5rem,11vw,6rem)]">
      <span class="block">{boda.novios.ella}</span>
      <span
        class="text-acid my-0.5 block text-[0.5em] normal-case italic sm:my-1"
        style="letter-spacing:0">&</span
      >
      <span class="block">{boda.novios.el}</span>
    </h1>

    {/* La marca del save-the-date, tal cual: blackletter en verde ácido. */}
    <p class="revelar fecha-marca mt-6 text-[clamp(3rem,14vw,7rem)]">
      {boda.fecha.marca}
    </p>

    <p class="revelar text-bone-dim mt-4 text-lg italic sm:text-xl">
      {boda.venue.nombre} · Ciudad de México
    </p>

    {/* Cuenta regresiva: se llena en el cliente para no servir HTML rancio. */}
    <div
      id="cuenta"
      class="revelar text-bone-dim mt-8 flex justify-center gap-6 sm:gap-10"
      aria-live="off"
    >
      {
        [
          ['dias', 'Días'],
          ['horas', 'Horas'],
          ['minutos', 'Min'],
          ['segundos', 'Seg'],
        ].map(([id, etiqueta]) => (
          <div class="text-center">
            <span id={`cuenta-${id}`} class="cifras text-bone block text-2xl sm:text-3xl">
              —
            </span>
            <span class="text-brass mt-1.5 block font-mono text-[0.5625rem] tracking-[0.22em] uppercase">
              {etiqueta}
            </span>
          </div>
        ))
      }
    </div>

    <a href="#rsvp" class="revelar btn mt-9 inline-flex"> Confirmar asistencia </a>
  </div>

  {/* En pantallas bajas el hero ya no cabe y este enlace se encimaría con el botón. */}
  <a
    href="#la-boda"
    class="bajar text-brass/60 hover:text-brass absolute bottom-8 left-1/2 -translate-x-1/2 font-mono text-[0.5625rem] tracking-[0.28em] uppercase transition-colors"
  >
    Bajar
  </a>
</section>

<script>
  import { boda } from '../config/boda';

  const destino = new Date(boda.fecha.iso).getTime();

  const celdas = {
    dias: document.getElementById('cuenta-dias'),
    horas: document.getElementById('cuenta-horas'),
    minutos: document.getElementById('cuenta-minutos'),
    segundos: document.getElementById('cuenta-segundos'),
  };

  const dosDigitos = (n: number) => String(n).padStart(2, '0');

  function actualizar() {
    const restante = destino - Date.now();

    if (restante <= 0) {
      // Ya llegó el día: en vez de números en cero, un mensaje.
      const contenedor = document.getElementById('cuenta');
      if (contenedor) {
        contenedor.innerHTML =
          '<p class="text-bone font-serif text-xl italic sm:text-2xl">Hoy es la noche.</p>';
      }
      return true;
    }

    const segundosTotales = Math.floor(restante / 1000);

    celdas.dias!.textContent = String(Math.floor(segundosTotales / 86400));
    celdas.horas!.textContent = dosDigitos(Math.floor(segundosTotales / 3600) % 24);
    celdas.minutos!.textContent = dosDigitos(Math.floor(segundosTotales / 60) % 60);
    celdas.segundos!.textContent = dosDigitos(segundosTotales % 60);

    return false;
  }

  if (!actualizar()) {
    const reloj = setInterval(() => {
      if (actualizar()) clearInterval(reloj);
    }, 1000);
  }
</script>

<style>
  @media (max-height: 800px) {
    .bajar {
      display: none;
    }
  }
</style>
