---
/**
 * Ya no hay pantalla de contraseña. Al cargar, el sitio se desbloquea solo
 * contra Apps Script para traer los datos bancarios de Regalos.
 * La contraseña vive en src/lib/api.ts (PASSWORD_INVITADOS).
 */
---

<script>
  import { unlock, leerPassword, publicarBanco } from '../lib/api';

  async function abrir(intento: number) {
    const r = await unlock(leerPassword());
    if (r.ok) {
      publicarBanco(r.banco);
      return;
    }
    // Apps Script arranca en frío: reintentar fallos de red un par de veces.
    if (r.error === 'red' && intento < 3) {
      setTimeout(() => void abrir(intento + 1), 2000 * intento);
      return;
    }
    console.warn('[boda] unlock falló:', r.error);
  }

  void abrir(1);
</script>
