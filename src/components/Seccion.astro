---
import Ornamento from './Ornamento.astro';

interface Props {
  id: string;
  eyebrow?: string;
  titulo: string;
  /** Frase en cursiva bajo el título. */
  intro?: string;
  /** `oscuro` = fondo base, `elevado` = un escalón más claro, `sangre` = bloque oxblood. */
  fondo?: 'oscuro' | 'elevado' | 'sangre';
  /** Ancho del contenido. */
  ancho?: 'estrecho' | 'normal' | 'ancho';
  class?: string;
}

const {
  id,
  eyebrow,
  titulo,
  intro,
  fondo = 'oscuro',
  ancho = 'normal',
  class: clase = '',
} = Astro.props;

const fondos = {
  oscuro: 'bg-ink',
  elevado: 'bg-ink-2',
  sangre: 'bg-oxblood/25',
} as const;

const anchos = {
  estrecho: 'max-w-2xl',
  normal: 'max-w-4xl',
  ancho: 'max-w-6xl',
} as const;
---

<section id={id} class={`relative overflow-hidden px-5 py-24 sm:px-8 sm:py-32 ${fondos[fondo]} ${clase}`}>
  {/* Filete superior: separa las secciones sin una línea dura. */}
  <div class="absolute inset-x-0 top-0 filete" aria-hidden="true"></div>

  <div class={`relative mx-auto ${anchos[ancho]}`}>
    <header class="revelar mb-14 text-center sm:mb-20">
      {eyebrow && <p class="eyebrow mb-5">{eyebrow}</p>}

      <h2 class="text-bone text-[clamp(2.25rem,7vw,4rem)]">{titulo}</h2>

      {/* Divisor: filete — rombo — filete */}
      <div class="mt-7 flex items-center justify-center gap-4" aria-hidden="true">
        <span class="filete w-16 sm:w-24"></span>
        <Ornamento tipo="rombo" class="text-brass h-3.5 w-3.5 shrink-0" />
        <span class="filete w-16 sm:w-24"></span>
      </div>

      {
        intro && (
          <p class="text-bone-dim mx-auto mt-8 max-w-2xl text-lg italic sm:text-xl">{intro}</p>
        )
      }
    </header>

    <slot />
  </div>
</section>
